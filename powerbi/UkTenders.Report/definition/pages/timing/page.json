{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "timing",
  "displayName": "How long to award?",
  "displayOption": "FitToPage",
  "height": 720,
  "width": 1280,
  "filterConfig": {
    "filters": [
      {
        "name": "last12CompleteMonths",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Date"
              }
            },
            "Property": "Date"
          }
        },
        "type": "RelativeDate",
        "filter": {
          "Version": 2,
          "From": [
            {
              "Name": "d",
              "Entity": "Date",
              "Type": 0
            }
          ],
          "Where": [
            {
              "Condition": {
                "Between": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Source": "d"
                        }
                      },
                      "Property": "Date"
                    }
                  },
                  "LowerBound": {
                    "DateSpan": {
                      "Expression": {
                        "DateAdd": {
                          "Expression": {
                            "Now": {}
                          },
                          "Amount": -12,
                          "TimeUnit": 2
                        }
                      },
                      "TimeUnit": 2
                    }
                  },
                  "UpperBound": {
                    "DateSpan": {
                      "Expression": {
                        "DateAdd": {
                          "Expression": {
                            "Now": {}
                          },
                          "Amount": -1,
                          "TimeUnit": 2
                        }
                      },
                      "TimeUnit": 2
                    }
                  }
                }
              }
            }
          ]
        }
      }
    ]
  },
  "visualInteractions": [
    {
      "source": "timing-slicerDays",
      "target": "timing-waitBands",
      "type": "NoFilter"
    },
    {
      "source": "timing-slicerDays",
      "target": "timing-kpiDaysToAward",
      "type": "NoFilter"
    },
    {
      "source": "timing-slicerDays",
      "target": "timing-kpiDaysToContract",
      "type": "NoFilter"
    },
    {
      "source": "timing-slicerDays",
      "target": "timing-kpiTendersAwarded",
      "type": "NoFilter"
    }
  ]
}
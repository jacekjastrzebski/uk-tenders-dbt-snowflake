    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Time horizon",
                    "textStyle": {
                      "fontFamily": "'DM Sans', 'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                      "fontSize": "13pt",
                      "color": "#0C2340"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The data starts on 24 February 2025, the day the Procurement Act 2023 came into force. Since then every notice follows the same rules and says whether it's a tender, an award or a contract, so a purchase can be followed from start to finish. Older notices work differently, so they're left out.",
                    "textStyle": {
                      "fontFamily": "'DM Sans', 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "9.5pt",
                      "color": "#4B5B70"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "'DM Sans', 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "4pt",
                      "color": "#4B5B70"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Open tenders are live, as of today. Everything else covers the last 12 complete months; the earlier months are kept so that tenders which started before that still count when they're awarded.",
                    "textStyle": {
                      "fontFamily": "'DM Sans', 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "9.5pt",
                      "color": "#4B5B70"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },

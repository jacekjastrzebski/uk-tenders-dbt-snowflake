/// One row per supplier on an award, from fct_award_suppliers; sum Allocated Value
/// (the supplier's equal share). Headline totals use Is In Headline (ADR 0022).
table Awards

	column 'Award Supplier Key'
		dataType: string
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: AWARD_SUPPLIER_KEY

	column 'Procurement Award Key'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: PROCUREMENT_AWARD_KEY

	column OCID
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: OCID

	column 'Award Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: AWARD_DATE

	column 'Buyer Key'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: BUYER_KEY

	column 'Supplier Key'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: SUPPLIER_KEY

	column 'CPV Division'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: CPV_DIVISION

	column 'Award Status'
		dataType: string
		summarizeBy: none
		sourceColumn: AWARD_STATUS

	column 'Allocated Value'
		dataType: double
		isHidden
		formatString: £#,0
		summarizeBy: sum
		sourceColumn: ALLOCATED_VALUE_GBP

	column 'Suppliers on Award'
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: SUPPLIERS_ON_AWARD

	column 'Value Source'
		dataType: string
		summarizeBy: none
		sourceColumn: VALUE_SOURCE

	column 'Date Source'
		dataType: string
		summarizeBy: none
		sourceColumn: DATE_SOURCE

	column 'Is Framework'
		dataType: boolean
		summarizeBy: none
		sourceColumn: IS_FRAMEWORK

	column 'Is Large Value'
		dataType: boolean
		summarizeBy: none
		sourceColumn: IS_LARGE_VALUE

	column 'Is In Headline'
		dataType: boolean
		summarizeBy: none
		sourceColumn: IS_IN_HEADLINE

	partition Awards = m
		mode: import
		source =
				let
				    Source = Marts{[Name = "FCT_AWARD_SUPPLIERS", Kind = "Table"]}[Data]
				in
				    Source

	annotation PBI_ResultType = Table

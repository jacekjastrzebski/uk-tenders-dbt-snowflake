/// One row per notice published on Find a Tender.
table Notices

	measure Notices = COUNTROWS(Notices)
		formatString: #,0

	/// Newest notice in the data; shows how fresh the report is
	measure 'Latest Notice' = MAX(Notices[Published At])
		formatString: dd mmm yyyy hh:nn

	column 'Notice ID'
		dataType: string
		summarizeBy: none
		sourceColumn: NOTICE_ID

	column OCID
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: OCID

	column 'Published At'
		dataType: dateTime
		formatString: dd mmm yyyy hh:nn
		summarizeBy: none
		sourceColumn: PUBLISHED_AT

	column 'Published Date'
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: PUBLISHED_DATE

	column 'Notice Type'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: NOTICE_TYPE

	column 'Is Procurement Act'
		dataType: boolean
		summarizeBy: none
		sourceColumn: IS_PROCUREMENT_ACT

	column 'Is Cancellation'
		dataType: boolean
		summarizeBy: none
		sourceColumn: IS_CANCELLATION

	column 'Buyer ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: BUYER_ID

	column 'CPV Code'
		dataType: string
		summarizeBy: none
		sourceColumn: CPV_CODE

	column 'CPV Division'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: CPV_DIVISION

	column Title
		dataType: string
		summarizeBy: none
		sourceColumn: TITLE

	column 'Tender Status'
		dataType: string
		summarizeBy: none
		sourceColumn: TENDER_STATUS

	column 'Tender Closing At'
		dataType: dateTime
		formatString: dd mmm yyyy hh:nn
		summarizeBy: none
		sourceColumn: TENDER_CLOSING_AT

	column 'Tender Value'
		dataType: decimal
		isHidden
		formatString: £#,0
		summarizeBy: sum
		sourceColumn: TENDER_VALUE_GBP

	column 'Award Value'
		dataType: decimal
		isHidden
		formatString: £#,0
		summarizeBy: sum
		sourceColumn: AWARD_VALUE_GBP

	column 'Contract Value'
		dataType: decimal
		isHidden
		formatString: £#,0
		summarizeBy: sum
		sourceColumn: CONTRACT_VALUE_GBP

	column 'Notice Value'
		dataType: decimal
		isHidden
		formatString: £#,0
		summarizeBy: sum
		sourceColumn: NOTICE_VALUE_GBP

	column 'Notice URL'
		dataType: string
		dataCategory: WebUrl
		summarizeBy: none
		sourceColumn: NOTICE_URL

	partition Notices = m
		mode: import
		source =
				let
				    Source = Marts{[Name = "FCT_NOTICES", Kind = "Table"]}[Data]
				in
				    Source

	annotation PBI_ResultType = Table

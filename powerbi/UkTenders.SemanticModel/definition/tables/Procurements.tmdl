/// One row per Procurement Act tender (a procurement with a UK4 notice), from
/// fct_procurements. Open = Closing Date from today, no award, not cancelled.
table Procurements

	column OCID
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: OCID

	column Title
		dataType: string
		summarizeBy: none
		sourceColumn: TITLE

	column 'Buyer Key'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: BUYER_KEY

	column 'CPV Division'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: CPV_DIVISION

	column 'Tender Published Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: TENDER_PUBLISHED_DATE

	column 'Closing Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: CLOSING_DATE

	column 'Award Published Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: AWARD_PUBLISHED_DATE

	column 'Contract Published Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: CONTRACT_PUBLISHED_DATE

	column 'Days Tender to Award'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: DAYS_TENDER_TO_AWARD

	column 'Days Award to Contract'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: DAYS_AWARD_TO_CONTRACT

	column 'Is Cancelled'
		dataType: boolean
		summarizeBy: none
		sourceColumn: IS_CANCELLED

	partition Procurements = m
		mode: import
		source =
				let
				    Source = Marts{[Name = "FCT_PROCUREMENTS", Kind = "Table"]}[Data]
				in
				    Source

	annotation PBI_ResultType = Table

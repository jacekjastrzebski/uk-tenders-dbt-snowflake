/// One row per Procurement Act tender (a procurement with a UK4 notice), from
/// fct_procurements. Open = Closing Date from today, no award, not cancelled.
table Procurements
	lineageTag: 1d64a086-5142-44d2-99c0-7b983d8db144

	measure Tenders = COUNTROWS(Procurements)
		formatString: #,0
		lineageTag: ff30c2e0-8f86-4d89-a946-5c6820001565

	/// Closing date from today, no award published, not cancelled; ignores the date slicer.
	/// Only tenders closing within the "Closes within" slicer's window (any time when nothing is chosen).
	measure 'Open Tenders' =
			VAR LastClosingDate = TODAY() + [Window Days]
			RETURN
			    CALCULATE(
			        COUNTROWS(Procurements),
			        REMOVEFILTERS('Date'),
			        KEEPFILTERS(Procurements[Closing Date] >= TODAY()),
			        KEEPFILTERS(Procurements[Closing Date] <= LastClosingDate),
			        KEEPFILTERS(Procurements[Award Published Date] = BLANK()),
			        KEEPFILTERS(Procurements[Is Cancelled] = FALSE())
			    )
		formatString: #,0
		displayFolder: Open tenders
		lineageTag: f4a14c49-bf22-4039-8885-27dde8ff43f4

	/// All open tenders, whatever the "Closes within" slicer says
	measure 'All Open Tenders' = CALCULATE([Open Tenders], REMOVEFILTERS('Closing Window')) + 0   // 0, not (Blank), when nothing matches
		formatString: #,0
		displayFolder: Open tenders
		lineageTag: 9d91024b-7967-4597-99b7-68e4bb7b457f

	/// Open tenders closing within the slicer's window; 14 days when nothing is chosen
	measure 'Closing Soon' =
			VAR LastClosingDate = TODAY() + SELECTEDVALUE('Closing Window'[Days], 14)
			RETURN
			    CALCULATE(
			        [Open Tenders],
			        REMOVEFILTERS('Closing Window'),
			        KEEPFILTERS(Procurements[Closing Date] <= LastClosingDate)
			    ) + 0   // 0, not (Blank), when nothing matches
		formatString: #,0
		displayFolder: Open tenders
		lineageTag: 56fd6412-d4ed-43a0-ad73-c29f7e9f1717

	/// Label under Closing Soon, e.g. "Close within 7 days"
	measure 'Closing Soon Label' =
			VAR WindowDays = SELECTEDVALUE('Closing Window'[Days], 14)
			RETURN
			    SWITCH(
			        TRUE(),
			        WindowDays = 0, "Close today",
			        WindowDays >= 36500, "Open, any closing date",
			        "Close within " & WindowDays & " days"
			    )
		displayFolder: Open tenders
		lineageTag: a67e081f-249e-4648-a2e6-59822989e2b7

	/// Blank unless open, so tables show open tenders only
	/// Shown as Today, 1 day or n days; still a number, so tables sort by it
	measure 'Days to Close' = IF([Open Tenders] > 0, INT(MAX(Procurements[Closing Date]) - TODAY()))
		displayFolder: Open tenders
		lineageTag: 113d80a2-7f0c-444b-a099-99ebc925ca82

		formatStringDefinition = SWITCH(SELECTEDMEASURE(), 0, """Today""", 1, """1 day""", "0 ""days""")

	/// Timings are dated by award: date filters and axes apply to the award date, not the tender date
	measure 'Median Days Tender to Award' = CALCULATE(MEDIAN(Procurements[Days Tender to Award]), USERELATIONSHIP(Procurements[Award Published Date], 'Date'[Date]))
		formatString: 0
		displayFolder: Timings
		lineageTag: 88b20e99-956c-48a4-90e3-f7cfa7bb0bdb

	/// Only awards at least 3 months old: contracts for newer awards are often not published yet, so
	/// counting them would leave only the quick ones and make the wait look shorter than it is
	measure 'Median Days Award to Contract' =
			CALCULATE(
			    MEDIAN(Procurements[Days Award to Contract]),
			    USERELATIONSHIP(Procurements[Award Published Date], 'Date'[Date]),
			    KEEPFILTERS(Procurements[Award Published Date] <= TODAY() - 91)
			)
		formatString: 0
		displayFolder: Timings
		lineageTag: 23b78e08-8560-453b-93cf-79a79e7efce1

	/// Tenders with an award published, dated by the award
	measure 'Tenders Awarded' =
			CALCULATE(
			    COUNTROWS(Procurements),
			    USERELATIONSHIP(Procurements[Award Published Date], 'Date'[Date]),
			    KEEPFILTERS(NOT ISBLANK(Procurements[Award Published Date]))
			)
		formatString: #,0
		displayFolder: Timings
		lineageTag: 7b92cdb9-161f-4648-bb09-19728a5a4db1

	/// Tenders Timed whose days for the chosen stage fall in the band on the axis (table Wait Band)
	measure 'Tenders in Wait Band' =
			VAR FromDays = SELECTEDVALUE('Wait Band'[From Days])
			VAR ToDays = SELECTEDVALUE('Wait Band'[To Days])
			VAR StageName = SELECTEDVALUE(Stage[Stage], "Tender to award")
			RETURN
			    IF(
			        StageName = "Award to contract",
			        CALCULATE(
			            [Tenders Timed],
			            KEEPFILTERS(Procurements[Days Award to Contract] >= FromDays),
			            KEEPFILTERS(Procurements[Days Award to Contract] <= ToDays)
			        ),
			        CALCULATE(
			            [Tenders Timed],
			            KEEPFILTERS(Procurements[Days Tender to Award] >= FromDays),
			            KEEPFILTERS(Procurements[Days Tender to Award] <= ToDays)
			        )
			    )
		formatString: #,0
		displayFolder: Timings
		lineageTag: f55e7eec-5bad-44da-b616-6e41b09aad1a

	/// Share of Tenders Timed that fall in the band; the bands add up to 100%
	measure 'Share in Wait Band' = DIVIDE([Tenders in Wait Band], [Tenders Timed])
		formatString: 0%
		displayFolder: Timings
		lineageTag: 4e3d4cde-4be0-4dc4-8fff-58df548aa2cf

	/// Share in Wait Band per legend group (table Colour Group), each group adding up to 100%:
	/// Digital and data / Other markets when no market is chosen, otherwise one per chosen market
	measure 'Share in Wait Band by Group' =
			VAR GroupName = SELECTEDVALUE('Colour Group'[Group])
			// colour by market once a Market, Sector or Buyer slicer is used (as Awarded Value by Group)
			VAR MarketChosen =
			    ISFILTERED(Sector[Market]) || ISFILTERED(Sector[Sector]) || ISFILTERED(Buyer[Buyer])
			RETURN
			    SWITCH(
			        TRUE(),
			        NOT MarketChosen && GroupName = "Digital and data",
			            CALCULATE([Share in Wait Band], KEEPFILTERS(Sector[Market] = "Digital and data")),
			        NOT MarketChosen && GroupName = "Other markets",
			            CALCULATE([Share in Wait Band], KEEPFILTERS(Sector[Market] <> "Digital and data")),
			        NOT MarketChosen || GroupName = "Other markets", BLANK(),
			        CALCULATE([Share in Wait Band], KEEPFILTERS(Sector[Market] = GroupName))
			    )
		formatString: 0%
		displayFolder: Timings
		lineageTag: d3632ee1-d539-4906-bea9-6b48c079ff5d

	/// Footnote on How long to award?: the months the page covers and how the numbers are counted
	measure 'Timing Note' =
			VAR Period = FORMAT(MIN('Date'[Date]), "mmm yyyy") & " to " & FORMAT(MAX('Date'[Date]), "mmm yyyy")
			RETURN
			    "Tenders awarded " & Period & ", in calendar days between notices. Earlier months are left out: the Act began "
			        & "in Feb 2025, so they'd look falsely fast. Award to contract counts awards at least 3 months old and with "
			        & "both notices. Cards show the median: half were quicker, half slower."
		displayFolder: Timings
		lineageTag: fb71fee9-7f93-4240-9770-509e41b60f5f

	/// Days for the stage chosen in the Stage slicer (tender to award when none is chosen):
	/// a tender's own days in a table row, the median elsewhere
	measure 'Days for Stage' =
			VAR StageName = SELECTEDVALUE(Stage[Stage], "Tender to award")
			RETURN
			    IF(StageName = "Award to contract", [Median Days Award to Contract], [Median Days Tender to Award])
		formatString: 0
		displayFolder: Timings
		lineageTag: a14d73aa-c309-450a-9758-20b27647a011

	/// Tenders awarded with days known for the chosen stage; for award to contract, only awards
	/// at least 3 months old, as in Median Days Award to Contract
	measure 'Tenders Timed' =
			VAR StageName = SELECTEDVALUE(Stage[Stage], "Tender to award")
			RETURN
			    IF(
			        StageName = "Award to contract",
			        CALCULATE(
			            [Tenders Awarded],
			            KEEPFILTERS(NOT ISBLANK(Procurements[Days Award to Contract])),
			            KEEPFILTERS(Procurements[Award Published Date] <= TODAY() - 91)
			        ),
			        CALCULATE([Tenders Awarded], KEEPFILTERS(NOT ISBLANK(Procurements[Days Tender to Award])))
			    )
		formatString: #,0
		displayFolder: Timings
		lineageTag: f7be6073-24b3-480b-9e06-b846dc066bb3

	/// The table's days column: each tender's days for the chosen stage. Clicking a bar in the wait
	/// chart filters the disconnected Wait Band and Colour Group tables, so only tenders in that band
	/// (and that bar's market group) keep a value and the table lists just them
	measure 'Days in Chosen Band' =
			VAR FromDays = MIN('Wait Band'[From Days])
			VAR ToDays = MAX('Wait Band'[To Days])
			VAR GroupName = SELECTEDVALUE('Colour Group'[Group])
			VAR Days =
			    SWITCH(
			        TRUE(),
			        ISBLANK(GroupName), [Days for Stage],
			        GroupName = "Digital and data", CALCULATE([Days for Stage], KEEPFILTERS(Sector[Market] = "Digital and data")),
			        GroupName = "Other markets", CALCULATE([Days for Stage], KEEPFILTERS(Sector[Market] <> "Digital and data")),
			        CALCULATE([Days for Stage], KEEPFILTERS(Sector[Market] = GroupName))
			    )
			RETURN
			    IF(NOT ISBLANK(Days) && Days >= FromDays && Days <= ToDays, Days)
		formatString: 0
		displayFolder: Timings
		lineageTag: fdab407a-8756-45c0-8ccf-ec068ed24bd6

	/// Chart and table titles that follow the Stage slicer
	measure 'Wait Chart Title' =
			VAR StageName = SELECTEDVALUE(Stage[Stage], "Tender to award")
			RETURN
			    IF(StageName = "Award to contract", "How long from award to contract", "How long tenders wait for an award")
		displayFolder: Timings
		lineageTag: 57581cff-b747-4544-b836-cfddcd8e0528

	measure 'Wait Table Title' =
			VAR StageName = SELECTEDVALUE(Stage[Stage], "Tender to award")
			RETURN
			    IF(StageName = "Award to contract", "Each award's wait for a contract, longest first", "Each tender's wait for an award, longest first")
		displayFolder: Timings
		lineageTag: 73ca0d5f-5077-4d42-94ea-6563f4a2294a

	column OCID
		dataType: string
		isKey
		lineageTag: 8112226c-942f-40bb-a31d-15a0b7fadab8

		sourceColumn: OCID

	column Title
		dataType: string
		lineageTag: 9f111f73-f0f1-4255-8241-13ac40c2867f
		summarizeBy: none
		sourceColumn: TITLE

	column 'Buyer Key'
		dataType: string
		isHidden
		lineageTag: 8766d470-560a-4369-9048-78d5ee4c0dc0
		summarizeBy: none
		sourceColumn: BUYER_KEY

	column 'CPV Division'
		dataType: string
		isHidden
		lineageTag: fa304be0-68bd-4b49-8346-71c139f53096
		summarizeBy: none
		sourceColumn: CPV_DIVISION

	column 'Tender Published Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 576799ee-76a5-4d80-aa04-9482e9961fd6
		summarizeBy: none
		sourceColumn: TENDER_PUBLISHED_DATE

		annotation UnderlyingDateTimeDataType = Date

	column 'Closing Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 938a993f-2162-4a13-8c83-5753160c79d1
		summarizeBy: none
		sourceColumn: CLOSING_DATE

		annotation UnderlyingDateTimeDataType = Date

	column 'Award Published Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 6c6616c5-9660-4705-802b-48e896b86589
		summarizeBy: none
		sourceColumn: AWARD_PUBLISHED_DATE

		annotation UnderlyingDateTimeDataType = Date

	column 'Contract Published Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 605a46c1-e505-4b70-ac7e-49cf5fe87f66
		summarizeBy: none
		sourceColumn: CONTRACT_PUBLISHED_DATE

		annotation UnderlyingDateTimeDataType = Date

	column 'Days Tender to Award'
		dataType: double
		formatString: 0
		lineageTag: 5c84fc82-3b7f-458d-b664-4b9367c70ada
		summarizeBy: sum
		sourceColumn: DAYS_TENDER_TO_AWARD

		annotation SummarizationSetBy = Automatic

	column 'Days Award to Contract'
		dataType: double
		formatString: 0
		lineageTag: 86b3b6a3-c019-4398-8e4a-cfcd4769aa16
		summarizeBy: sum
		sourceColumn: DAYS_AWARD_TO_CONTRACT

		annotation SummarizationSetBy = Automatic

	column 'Is Cancelled'
		dataType: boolean
		lineageTag: 99569fd8-c9d6-4aeb-9ab0-0f08af88cf99
		summarizeBy: none
		sourceColumn: IS_CANCELLED

	partition Procurements = m
		mode: import
		source =
				let
				    Source = Marts{[Name = "FCT_PROCUREMENTS", Kind = "Table"]}[Data]
				in
				    Source

	annotation PBI_ResultType = Table


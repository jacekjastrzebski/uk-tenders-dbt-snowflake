/// One row per Procurement Act tender (a procurement with a UK4 notice), from
/// fct_procurements. Open = Closing Date from today, no award, not cancelled.
table Procurements

	measure Tenders = COUNTROWS(Procurements)
		formatString: #,0

	/// Closing date from today, no award published, not cancelled; ignores the date slicer
	measure 'Open Tenders' =
			CALCULATE(
			    COUNTROWS(Procurements),
			    REMOVEFILTERS('Date'),
			    KEEPFILTERS(Procurements[Closing Date] >= TODAY()),
			    KEEPFILTERS(Procurements[Award Published Date] = BLANK()),
			    KEEPFILTERS(Procurements[Is Cancelled] = FALSE())
			)
		formatString: #,0
		displayFolder: Open tenders

	measure 'Closing in 14 Days' = CALCULATE([Open Tenders], KEEPFILTERS(Procurements[Closing Date] < TODAY() + 14))
		formatString: #,0
		displayFolder: Open tenders

	/// Blank unless open, so tables show open tenders only
	measure 'Days to Close' = IF([Open Tenders] > 0, INT(MAX(Procurements[Closing Date]) - TODAY()))
		formatString: 0
		displayFolder: Open tenders

	measure 'Median Days Tender to Award' = MEDIAN(Procurements[Days Tender to Award])
		formatString: 0
		displayFolder: Timings

	measure 'Median Days Award to Contract' = MEDIAN(Procurements[Days Award to Contract])
		formatString: 0
		displayFolder: Timings

	/// Same median, with the date slicer and axis applied to the award date instead of the tender date
	measure 'Median Days Tender to Award by Award Month' =
			CALCULATE([Median Days Tender to Award], USERELATIONSHIP(Procurements[Award Published Date], 'Date'[Date]))
		formatString: 0
		displayFolder: Timings

	/// Latest tender in the data, ignoring all filters
	measure 'Data As Of' = CALCULATE(MAX(Procurements[Tender Published Date]), REMOVEFILTERS())
		formatString: dd mmm yyyy

	column OCID
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: OCID

	column Title
		dataType: string
		summarizeBy: none
		sourceColumn: TITLE

	column 'Buyer Key'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: BUYER_KEY

	column 'CPV Division'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: CPV_DIVISION

	column 'Tender Published Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: TENDER_PUBLISHED_DATE

	column 'Closing Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: CLOSING_DATE

	column 'Award Published Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: AWARD_PUBLISHED_DATE

	column 'Contract Published Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: CONTRACT_PUBLISHED_DATE

	column 'Days Tender to Award'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: DAYS_TENDER_TO_AWARD

	column 'Days Award to Contract'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: DAYS_AWARD_TO_CONTRACT

	column 'Is Cancelled'
		dataType: boolean
		summarizeBy: none
		sourceColumn: IS_CANCELLED

	partition Procurements = m
		mode: import
		source =
				let
				    Source = Marts{[Name = "FCT_PROCUREMENTS", Kind = "Table"]}[Data]
				in
				    Source

	annotation PBI_ResultType = Table

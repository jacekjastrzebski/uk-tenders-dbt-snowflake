/// One row per day, from dim_dates; mark as date table. UK financial year April to March.
table Date
	lineageTag: 2246d23e-77f8-4ab1-a71f-8b88e611c9e8
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd mmm yyyy
		lineageTag: 4ef9b1b9-6b1d-4a3b-b1bb-ef57694e7285
		summarizeBy: none
		sourceColumn: CALENDAR_DATE

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: double
		formatString: 0
		lineageTag: bd55c43c-b65e-4d0b-9945-b5c6ae97450d
		summarizeBy: sum
		sourceColumn: CALENDAR_YEAR

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		dataType: double
		isHidden
		formatString: 0
		lineageTag: a222e2c4-0174-4adb-a23d-4e7e93cb677c
		summarizeBy: sum
		sourceColumn: MONTH_NUMBER

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: 5a8f0c3f-8e8b-4498-a014-83d282d91926
		summarizeBy: none
		sourceColumn: MONTH_NAME
		sortByColumn: 'Month Number'

	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 90510a76-ddca-4151-ade0-41a6744ef6a6
		summarizeBy: none
		sourceColumn: MONTH_START

		annotation UnderlyingDateTimeDataType = Date

	column 'Year Month'
		dataType: string
		lineageTag: 71e11bf6-2af2-4468-8194-d7c40548db52
		summarizeBy: none
		sourceColumn: YEAR_MONTH

	column 'Week Start'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 05f41a5e-dbe8-44b0-a0d5-eef772e191c6
		summarizeBy: none
		sourceColumn: WEEK_START

		annotation UnderlyingDateTimeDataType = Date

	column 'Financial Year'
		dataType: string
		lineageTag: 29a14231-5be7-4bb9-b765-ecfc6885295a
		summarizeBy: none
		sourceColumn: FINANCIAL_YEAR

	column 'Financial Month Number'
		dataType: double
		isHidden
		formatString: 0
		lineageTag: 4de5efeb-95f5-47d9-9861-955717991556
		summarizeBy: sum
		sourceColumn: FINANCIAL_MONTH_NUMBER

		annotation SummarizationSetBy = Automatic

	/// The dates the historical pages show (Home's tiles, Who's buying?, Who's winning?, How long to
	/// award?): from 24 Feb 2025, when the Procurement Act 2023 came in, to the day of the refresh.
	/// Their page filters keep In Report = True, so the window moves with each refresh and the report
	/// stores no dates (ADR 0037). Wait Days takes its range from it too.
	column 'In Report' = 'Date'[Date] >= DATE(2025, 2, 24) && 'Date'[Date] <= TODAY()
		dataType: boolean
		isHidden
		lineageTag: 9bf4eb2b-a91d-49a5-adc1-909a6bd47cfd
		summarizeBy: none

	partition Date = m
		mode: import
		source =
				let
				    Source = Marts{[Name = "DIM_DATES", Kind = "Table"]}[Data]
				in
				    Source

	annotation PBI_ResultType = Table


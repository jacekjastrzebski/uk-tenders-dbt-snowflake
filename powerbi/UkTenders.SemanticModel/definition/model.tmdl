model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SnowflakeServer","SnowflakeWarehouse","SnowflakeRole","SnowflakeDatabase","SnowflakeSchema","Marts","Date","Buyer","Supplier","Sector","Awards","Procurements","Data Freshness"]

annotation PBI_ProTooling = ["DevMode"]

ref table Date
ref table Buyer
ref table Supplier
ref table Sector
ref table Awards
ref table Procurements
ref table 'Data Freshness'
ref table Navigation
ref table 'Closing Window'
ref table 'Colour Group'
ref table 'Wait Band'
ref table 'Win Band'
ref table Stage
ref table 'Wait Days'

ref cultureInfo en-GB


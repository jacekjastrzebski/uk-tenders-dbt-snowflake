model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SnowflakeServer","SnowflakeWarehouse","SnowflakeRole","SnowflakeDatabase","SnowflakeSchema","Marts","Date","Buyer","Supplier","Sector","Notice Type","Notices","Awards","Procurements"]

ref table 'Date'
ref table Buyer
ref table Supplier
ref table Sector
ref table 'Notice Type'
ref table Notices
ref table Awards
ref table Procurements
